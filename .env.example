# MiraVoiceAI Pipecat Server - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
HOST=0.0.0.0
PORT=7860

# =============================================================================
# STT CONFIGURATION (Soniox - REQUIRED)
# =============================================================================
# Get your API key from https://soniox.com
SONIOX_API_KEY=your_soniox_api_key_here

# =============================================================================
# TTS CONFIGURATION
# =============================================================================
# Provider: "elevenlabs" (default) or "svara"
TTS_PROVIDER=elevenlabs

# ElevenLabs (required if TTS_PROVIDER=elevenlabs)
# Get your API key from https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Voice gender for ElevenLabs: "female" or "male"
TTS_VOICE_GENDER=female

# Svara TTS fallback (only needed if TTS_PROVIDER=svara)
TTS_WS_URL=ws://localhost:8080/v1/audio/text-to-speech/stream
DEFAULT_VOICE=hi_male

# =============================================================================
# LLM CONFIGURATION
# =============================================================================
LLM_BASE_URL=http://vllm-gpt-oss-120b/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=DUMMY_KEY

# =============================================================================
# VOICE ASSISTANT CONFIGURATION
# =============================================================================
DEFAULT_LANGUAGE=auto

# System prompt (optional - uses default if not set)
# SYSTEM_PROMPT=You are a helpful voice assistant...

# Greeting text spoken when connection is established (optional)
# GREETING_TEXT=Hello! I'm your voice assistant...
