# MiraVoiceAI Pipecat Server - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# SERVER
# =============================================================================
HOST=0.0.0.0
PORT=7860

# =============================================================================
# STT (Soniox - REQUIRED)
# =============================================================================
SONIOX_API_KEY=your_soniox_api_key

# =============================================================================
# TTS
# =============================================================================
# Provider: "elevenlabs" (default) or "svara"
TTS_PROVIDER=elevenlabs
TTS_VOICE_GENDER=female

# ElevenLabs (required if TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Svara TTS (required if TTS_PROVIDER=svara)
TTS_WS_URL=ws://svara-tts/v1/audio/text-to-speech/stream
TTS_WS_API_KEY=your_svara_api_key

# =============================================================================
# LLM
# =============================================================================
LLM_BASE_URL=http://your-llm-server/v1
LLM_MODEL=your-model-name
LLM_API_KEY=your_llm_api_key

# =============================================================================
# ASSISTANT
# =============================================================================
DEFAULT_LANGUAGE=auto
PROMPT_VERSION=v0
# GREETING_TEXT=Hi, I'm Mira! How can I help you today?
